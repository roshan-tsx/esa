VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex deployment env (run: npx convex env set KEY value)
# Required for Google OAuth:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Already set during auth setup:
# SITE_URL=http://localhost:3000
#
# Google Cloud Console OAuth client:
# - Authorized JavaScript origins: http://localhost:3000
# - Authorized redirect URI: https://<your-deployment>.convex.site/api/auth/callback/google
#   (e.g. https://mild-hawk-523.convex.site/api/auth/callback/google)
#
# Set credentials:
# npx convex env set AUTH_GOOGLE_ID "your-client-id"
# npx convex env set AUTH_GOOGLE_SECRET "your-client-secret"

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRO_PLAN_ID=
DODO_ENVIRONMENT=test_mode

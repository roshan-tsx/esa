# ==============================================================================
# FINAL .CURSORIGNORE TEMPLATE
# ==============================================================================

# 1. Media, Photos, & Assets (Blocks AI from reading/indexing images & video)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.webp
*.mp4
*.mov
*.mp3
*.wav
assets/
images/
public/assets/

# 2. Sensitive Data & Secrets (Prevents leaking API keys & credentials)
.env
.env.*
*.pem
*.key
*.cert
credentials.json
secrets/

# 3. Dependencies & Package Managers (Keeps indexing fast)
node_modules/
bower_components/
vendor/
.pnp/
.pnp.js

# 4. Build Outputs & Compiled Code
dist/
build/
out/
target/
*.exe
*.dll
*.so
*.dylib

# 5. Virtual Environments & Language Caches
venv/
.venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.tst/

# 6. System Files & Editor Clutter
.DS_Store
Thumbs.db
.desktop
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 7. Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*